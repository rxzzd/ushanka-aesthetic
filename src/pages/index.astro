---
import { getCollection } from "astro:content";
import Post from "../components/post/Post.astro";
import "../styles/global.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";

const allPosts = await getCollection("posts");

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>j'entends ta voix</title>
  </head>
  <body>
    <ThemeSwitcher />

    <div class="theme-switcher-container" />
    <main class="container">
      <header class="main-header">
        <h1>j'entends ta voix</h1>
        <p>˙⋆✮୨ৎ✮⋆˙</p>
      </header>

      <section class="posts-list">
        {
          sortedPosts.map((post) => (
            <Post
              title={post.data.title}
              date={post.data.date}
              images={post.data.imgs}
              audioSrc={post.data.audioSrc}
              metadata={post.data.metadata}
            />
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
  }

  .container {
    max-width: 600px;
    width: 100%;
    padding: 40px 20px;
  }

  .main-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .main-header h1 {
    font-size: 2rem;
    margin: 0 0 8px 0;
    font-weight: 300;
    letter-spacing: 1px;
  }

  .main-header p {
    color: #666;
    margin: 0;
    font-size: 0.9rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  ::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  const dateElements = document.querySelectorAll(".post-date");
  dateElements.forEach((el) => {
    const rawDate = el.getAttribute("data-date");
    if (rawDate) {
      const localDate = new Date(rawDate);
      el.textContent = localDate.toLocaleDateString(navigator.language, {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    }
  });
</script>
