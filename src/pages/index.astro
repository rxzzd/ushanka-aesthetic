---
import { getCollection } from "astro:content";
import Post from "../components/post/Post.astro";
import "../styles/global.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import SpeedInsights from '@vercel/speed-insights/astro';
import WelcomePage from "../components/WelcomeModule.astro";

const allPosts = await getCollection("posts");

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>j'entends ta voix</title>
  </head>
  <body>
    <ThemeSwitcher />
    <WelcomePage />

    <main class="container">
      <header class="main-header">
        <div class="title-wrapper">
    <button id="open-welcome-btn" class="info-btn" aria-label="Open information modal">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    </button>
    <h1>𓆩༺ 𝔧'𝔢𝔫𝔱𝔢𝔫𝔡𝔰 𝔱𝔞 𝔳𝔬𝔦𝔵 ༻𓆪</h1>
  </div>
        <h3>˙⋆✮୨ৎ✮⋆˙</h3>
      </header>

      <section class="posts-list">
        {
          sortedPosts.map((post) => (
            <Post
              title={post.data.title}
              date={post.data.date}
              images={post.data.imgs}
              audioSrc={post.data.audioSrc}
              metadata={post.data.metadata}
            />
          ))
        }
      </section>
    </main>
    <SpeedInsights />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
  }

  .container {
    max-width: 600px;
    width: 100%;
    padding: 40px 16px;
    box-sizing: border-box;
  }

  .main-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .main-header h1 {
    font-size: 2rem;
    margin: 0 0 8px 0;
    font-weight: 300;
    letter-spacing: 1px;
  }

  .title-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .info-btn {
    position: static;
    background: none;
    border: none;
    color: var(--text-color);
    opacity: 0.5;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .info-btn:hover {
    opacity: 1;
    color: var(--accent-color);
    transform: scale(1.1);
  }

  .main-header h3 {
    margin: 0;
    font-weight: normal;
    color: var(--text-color);
    opacity: 0.8;
  }

  .main-header p {
    color: #666;
    margin: 0;
    font-size: 0.9rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  ::-webkit-scrollbar {
    display: none;
  }

  
</style>

<script is:inline>
  const dateElements = document.querySelectorAll(".post-date");
  dateElements.forEach((el) => {
    const rawDate = el.getAttribute("data-date");
    if (rawDate) {
      const localDate = new Date(rawDate);
      el.textContent = localDate.toLocaleDateString(navigator.language, {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    }
  });
</script>

