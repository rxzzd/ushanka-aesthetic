---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>j'entends ta voix</title>
  </head>
  <body>
    <main class="container">
      <header class="main-header">
        <h1>j'entends ta voix</h1>
        <p>атмосферные музыкальные подборки</p>
      </header>

      <section class="posts-list">
        <!-- Мапим отсортированные посты -->
        {sortedPosts.map((post) => (
          <Post 
            title={post.data.title} 
            date={post.data.date.toLocaleDateString('ru-RU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            })}
            img1={post.data.img1} 
            img2={post.data.img2} 
            audioSrc={post.data.audioSrc} 
          />
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  /* Глобальный селектор :global(...) позволяет применить стили к тегу body за пределами компонента */
  :global(body) {
    background-color: #130f0d;
    color: #e0e0e0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
  }

  .container {
    max-width: 600px;
    width: 100%;
    padding: 40px 20px;
  }

  .main-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .main-header h1 {
    font-size: 2rem;
    margin: 0 0 8px 0;
    font-weight: 300;
    letter-spacing: 1px;
  }

  .main-header p {
    color: #666;
    margin: 0;
    font-size: 0.9rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
