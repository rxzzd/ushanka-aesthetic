---
interface Props {
  audioSrc?: string | null;
  metadata?: {
    artist?: string;
    title?: string;
    cover?: string | null;
  };
}

const { audioSrc, metadata } = Astro.props;
---

<div class="audio-container">
  {
    audioSrc && (
      <div class="custom-player">
        <audio class="audio-element" src={audioSrc} />
        <div class="player-left">
          <div class="cover-wrapper">
            {metadata?.cover ? (
              <img src={metadata.cover} class="player-cover" alt="Cover" />
            ) : (
              <div class="player-cover-fallback" />
            )}

            <button class="play-btn" aria-label="Play/Pause">
              <svg
                class="icon play-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M8 5v14l11-7z" />
              </svg>
              <svg
                class="icon pause-icon hidden"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
              </svg>
            </button>
          </div>
        </div>

        <div class="player-right">
          <div class="song-meta">
            <span class="song-artist">
              {metadata?.artist || "Unknown Artist"}
            </span>
            <span class="song-separator"> — </span>
            <span class="song-title">{metadata?.title || "Unknown Track"}</span>
          </div>

          <div class="player-controls">
            <span class="time-display time-current">0:00</span>
            <input type="range" class="timeline" min="0" value="0" step="0.1" />
            <span class="time-display time-duration">0:00</span>

            <div class="volume-container">
              <svg
                class="icon volume-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
              </svg>
              <input
                type="range"
                class="volume-slider"
                min="0"
                max="1"
                step="0.01"
                value="0.3"
              />
            </div>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .audio-container {
    width: 100%;
  }

  .custom-player {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 18px;
    background-color: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .player-left {
    flex-shrink: 0;
  }

  .cover-wrapper {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .player-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .player-cover-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #512224, #1a0809);
  }

  .play-btn {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.45);
    border: none;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background-color 0.2s ease;
  }

  .play-btn:hover {
    background-color: rgba(0, 0, 0, 0.3);
  }

  .play-btn:active .icon {
    transform: scale(0.9);
  }

  .icon {
    width: 20px;
    height: 24px;
    transition: transform 0.1s ease;
  }

  .player-right {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
    min-width: 0;
  }

  .song-meta {
    font-size: 0.9rem;
    font-weight: 500;
    text-align: left;
    margin-left: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    user-select: none;
  }

  .song-artist {
    color: #ffffff;
  }

  .song-separator {
    color: #888888;
  }

  .song-title {
    color: #e0e0e0;
    font-weight: 400;
  }

  .player-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .hidden {
    display: none !important;
  }

  .time-display {
    font-size: 0.8rem;
    color: #a0a0a0;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    min-width: 38px;
    text-align: center;
    user-select: none;
    flex-shrink: 0;
  }

  .timeline {
    flex-grow: 1;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    cursor: pointer;
    margin: 0;
    height: 20px;
    display: flex;
    align-items: center;
  }

  .timeline:focus {
    outline: none;
  }

  .timeline::-webkit-slider-runnable-track {
    background: rgba(255, 255, 255, 0.15);
    height: 4px;
    border-radius: 2px;
    transition: background 0.15s ease;
  }

  .timeline:hover::-webkit-slider-runnable-track {
    background: rgba(255, 255, 255, 0.3);
  }

  .timeline::-moz-range-track {
    background: rgba(255, 255, 255, 0.15);
    height: 4px;
    border-radius: 2px;
  }

  .timeline::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    margin-top: -4px;
    background-color: var(--accent-color);
    height: 12px;
    width: 12px;
    border-radius: 50%;
    transition:
      background-color 0.1s ease,
      transform 0.1s ease;
  }

  .timeline::-webkit-slider-thumb:hover {
    background-color: #ffffff;
    transform: scale(1.2);
  }

  .timeline::-moz-range-thumb {
    border: none;
    background-color: var(--accent-color);
    height: 12px;
    width: 12px;
    border-radius: 50%;
    transition:
      background-color 0.1s ease,
      transform 0.1s ease;
  }

  .volume-container {
    display: flex;
    align-items: center;
    gap: 0px;
    flex-shrink: 0;
  }

  .volume-icon {
    width: 18px;
    height: 18px;
    color: #a0a0a0;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .volume-icon:hover {
    color: #ffffff;
  }

  .volume-slider {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    cursor: pointer;
    width: 0px;
    opacity: 0;
    pointer-events: none;
    height: 20px;
    display: flex;
    align-items: center;
    transition:
      width 0.25s ease,
      opacity 0.2s ease,
      margin-left 0.25s ease;
    margin-left: 0px;
  }

  .volume-container:hover .volume-slider,
  .volume-container.active .volume-slider {
    width: 70px;
    opacity: 1;
    pointer-events: auto;
    margin-left: 6px;
  }

  .volume-slider:focus {
    outline: none;
  }

  .volume-slider::-webkit-slider-runnable-track {
    background: rgba(255, 255, 255, 0.2);
    height: 3px;
    border-radius: 1.5px;
  }

  .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    margin-top: -3.5px;
    background-color: #e0e0e0;
    height: 10px;
    width: 10px;
    border-radius: 50%;
  }

  .volume-slider::-moz-range-track {
    background: rgba(255, 255, 255, 0.2);
    height: 3px;
    border-radius: 1.5px;
  }

  .volume-slider::-moz-range-thumb {
    border: none;
    background-color: #e0e0e0;
    height: 10px;
    width: 10px;
    border-radius: 50%;
  }

  @media (max-width: 550px) {
    .volume-container {
      position: relative;
    }

    .volume-slider {
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translate(-58%, -113%) rotate(-90deg);
    }
  }
</style>

<script>
  import { formatTime } from "../../utils/formatters";

  const playedPlayers = new Set<Element>();

  const players = document.querySelectorAll(".custom-player");

  players.forEach((player) => {
    let isDragging = false;

    const audio = player.querySelector<HTMLAudioElement>(".audio-element");

    const button = player.querySelector<HTMLButtonElement>(".play-btn");

    const timeline = player.querySelector<HTMLInputElement>(".timeline");
    const volumeSlider =
      player.querySelector<HTMLInputElement>(".volume-slider");

    const timeCurrent = player.querySelector<HTMLSpanElement>(".time-current");
    const timeDuration =
      player.querySelector<HTMLSpanElement>(".time-duration");
    const volumeContainer =
      player.querySelector<HTMLDivElement>(".volume-container");
    const volumeIcon = player.querySelector<SVGElement>(".volume-icon");

    const playIcon = button?.querySelector(".play-icon");
    const pauseIcon = button?.querySelector(".pause-icon");

    if (
      audio &&
      volumeSlider &&
      volumeContainer &&
      volumeIcon &&
      timeline &&
      timeCurrent &&
      timeDuration &&
      playIcon &&
      pauseIcon &&
      button
    ) {
      audio.volume = parseFloat(volumeSlider.value);

      const updateButtonUI = () => {
        if (audio.paused || audio.ended) {
          playIcon.classList.remove("hidden");
          pauseIcon.classList.add("hidden");
        } else {
          playIcon.classList.add("hidden");
          pauseIcon.classList.remove("hidden");
        }
      };

      const handleMetadata = () => {
        timeline.max = audio.duration.toString();
        timeDuration.textContent = formatTime(audio.duration);
      };

      audio.addEventListener("timeupdate", () => {
        if (!isDragging) {
          timeline.value = audio.currentTime.toString();
          timeCurrent.textContent = formatTime(audio.currentTime);
        }
      });

      audio.addEventListener("ended", () => {
        updateButtonUI();
        timeline.value = "0";
        timeCurrent.textContent = "00:00";
      });

      audio.addEventListener("loadedmetadata", handleMetadata);

      if (audio.readyState >= 1) {
        handleMetadata();
      }

      timeline.addEventListener("input", () => {
        timeCurrent.textContent = formatTime(Number(timeline.value));
      });

      volumeSlider.addEventListener("input", () => {
        const volumeValue = parseFloat(volumeSlider.value);
        audio.volume = volumeValue;

        players.forEach((otherPlayer) => {
          if (otherPlayer !== player && !playedPlayers.has(otherPlayer)) {
            const otherAudio =
              otherPlayer.querySelector<HTMLAudioElement>(".audio-element");
            const otherVolume =
              otherPlayer.querySelector<HTMLInputElement>(".volume-slider");
            if (otherAudio && otherVolume) {
              otherAudio.volume = volumeValue;
              otherVolume.value = volumeValue.toString();
            }
          }
        });
      });

      volumeIcon.addEventListener("click", (e) => {
        e.stopPropagation();
        volumeContainer.classList.toggle("active");
      });

      volumeSlider.addEventListener("click", (e) => {
        e.stopPropagation();
      });

      document.addEventListener("click", () => {
        volumeContainer.classList.remove("active");
      });

      // for pc
      timeline.addEventListener("mousedown", () => {
        isDragging = true;
      });

      timeline.addEventListener("mouseup", () => {
        if (isDragging) {
          audio.currentTime = Number(timeline.value);
          timeCurrent.textContent = formatTime(audio.currentTime);
          isDragging = false;
        }
      });

      // for mobile
      timeline.addEventListener("touchstart", () => {
        isDragging = true;
      });

      timeline.addEventListener("touchend", () => {
        if (isDragging) {
          audio.currentTime = Number(timeline.value);
          timeCurrent.textContent = formatTime(audio.currentTime);
          isDragging = false;
        }
      });

      audio.addEventListener("play", () => {
        const allAudios =
          document.querySelectorAll<HTMLAudioElement>(".audio-element");
        allAudios.forEach((otherAudio) => {
          if (otherAudio != audio) {
            otherAudio.pause();
          }
        });
        updateButtonUI();
      });

      audio.addEventListener("pause", () => {
        updateButtonUI();
      });

      button.addEventListener("click", () => {
        playedPlayers.add(player);

        if (audio.paused || audio.ended) {
          audio.play();
        } else {
          audio.pause();
        }
      });
    }
  });
</script>
