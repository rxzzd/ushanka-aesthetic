---
interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
---

<header class="post-header">
  <h3>{title}</h3>
  <span class="post-date" data-date={date.toISOString()}></span>
</header>

<style>
  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    gap: 10px;
  }

  .post-header h3 {
    margin: 0;
    color: var(--text-color);
    font-size: clamp(0.9rem, 3.5vw, 1.1rem);
    font-weight: 500;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-date {
    color: #888;
    font-size: clamp(0.7rem, 2.5vw, 0.85rem);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .post-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      margin-bottom: 8px;
    }

    .post-header h3 {
      width: 100%;
    }
  }
</style>
